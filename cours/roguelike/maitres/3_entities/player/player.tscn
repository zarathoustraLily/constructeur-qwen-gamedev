[gd_scene format=3]

[ext_resource type="Script" path="res://3_entities/player/player.gd" id="1_player"]
[ext_resource type="Resource" path="res://5_data/player/player_settings.tres" id="2_settings"]
[ext_resource type="Script" path="res://3_entities/player/player_input.gd" id="3_input"]
;@ 2
[ext_resource type="PackedScene" path="res://6_assets/models/kaykit/KayKit_GameDevTV_Free_Sample_Pack_1.0/Character/GamedevTV_Mannequin_Medium.glb" id="4_model"]
;@ 3+
[ext_resource type="PackedScene" path="res://3_entities/player/animated_player.tscn" id="4_model"]
;@ all
[ext_resource type="Script" path="res://1_core/state_machine/state_machine.gd" id="5_machine"]
[ext_resource type="Script" path="res://3_entities/player/states/player_run.gd" id="6_run"]
[ext_resource type="Script" path="res://3_entities/player/states/player_fall.gd" id="7_fall"]
;@ 4+
[ext_resource type="Script" path="res://1_core/camera/shake_camera_3d.gd" id="8_shake"]
;@ 5+
[ext_resource type="Script" path="res://3_entities/player/states/player_dash.gd" id="9_dash"]
[ext_resource type="Script" path="res://3_entities/player/player_view.gd" id="10_view"]
[ext_resource type="Shader" path="res://6_assets/shaders/dash.gdshader" id="11_dash_shader"]
[ext_resource type="AudioStream" path="res://6_assets/audio/dash.ogg" id="12_dash_audio"]
;@ 6+
[ext_resource type="Script" path="res://1_core/components/health_component.gd" id="13_health"]
[ext_resource type="Script" path="res://1_core/components/knockback_component.gd" id="14_knockback"]
[ext_resource type="Script" path="res://3_entities/player/states/player_attack.gd" id="15_attack"]
[ext_resource type="Resource" path="res://5_data/player/attacks/slash.tres" id="16_slash"]
[ext_resource type="Resource" path="res://5_data/player/attacks/stab.tres" id="17_stab"]
[ext_resource type="Resource" path="res://5_data/player/attacks/spin.tres" id="18_spin"]
;@ 9+
[ext_resource type="AudioStream" path="res://6_assets/audio/metal-hit.ogg" id="19_damage_audio"]
[ext_resource type="Resource" path="res://5_data/input/hit_rumble.tres" id="20_hit_rumble"]
;@ all

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_player"]
;@ 4+

[sub_resource type="FastNoiseLite" id="FastNoiseLite_shake"]
noise_type = 2
fractal_type = 0
;@ 5+

[sub_resource type="FastNoiseLite" id="FastNoiseLite_dash"]
noise_type = 2
frequency = 0.005
fractal_type = 0

[sub_resource type="NoiseTexture2D" id="NoiseTexture2D_dash"]
noise = SubResource("FastNoiseLite_dash")
seamless = true

[sub_resource type="Gradient" id="Gradient_dash"]
offsets = PackedFloat32Array(0, 0.5)
colors = PackedColorArray(0.47843137, 0.8745098, 0.8235294, 1, 0.17254902, 0.44313726, 0.4117647, 1)

[sub_resource type="GradientTexture1D" id="GradientTexture1D_dash"]
gradient = SubResource("Gradient_dash")

[sub_resource type="ShaderMaterial" id="ShaderMaterial_dash"]
render_priority = 0
shader = ExtResource("11_dash_shader")
shader_parameter/speed = 2.0
shader_parameter/noise_texture = SubResource("NoiseTexture2D_dash")
shader_parameter/gradient_texture = SubResource("GradientTexture1D_dash")
shader_parameter/threshold = 1.0

[sub_resource type="QuadMesh" id="QuadMesh_vertical_trail"]
size = Vector2(3, 2)

[sub_resource type="QuadMesh" id="QuadMesh_ground_trail"]
size = Vector2(5, 1)

[sub_resource type="Animation" id="Animation_dash_reset"]
length = 0.001
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("VerticalTrail:material_override:shader_parameter/threshold")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 0,
"values": [1.0]
}

[sub_resource type="Animation" id="Animation_dash"]
resource_name = "dash"
length = 0.5
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("VerticalTrail:material_override:shader_parameter/threshold")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.5),
"transitions": PackedFloat32Array(2, 1),
"update": 0,
"values": [0.0, 1.0]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_dash"]
_data = {
&"RESET": SubResource("Animation_dash_reset"),
&"dash": SubResource("Animation_dash")
}
;@ all

[node name="Player" type="CharacterBody3D" node_paths=PackedStringArray("input") groups=["player"]]
collision_layer = 17
script = ExtResource("1_player")
settings = ExtResource("2_settings")
input = NodePath("PlayerInput")
;@ 5+

[node name="DashCooldown" type="Timer" parent="."]
one_shot = true
;@ all

[node name="PlayerInput" type="Node" parent="." node_paths=PackedStringArray("body")]
script = ExtResource("3_input")
body = NodePath("..")

[node name="Mannequin" parent="." instance=ExtResource("4_model")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1, 0)

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("CapsuleShape3D_player")

[node name="CameraRoot" type="Node3D" parent="."]
transform = Transform3D(-0.70710677, -0.5416752, 0.45451948, 0, 0.64278764, 0.76604444, -0.70710677, 0.5416752, -0.45451948, 0, 0, 0)

[node name="Camera3D" type="Camera3D" parent="CameraRoot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 10)
fov = 65.0
;@ 4+
script = ExtResource("8_shake")
noise = SubResource("FastNoiseLite_shake")
offset_scale = 3.0
;@ all

[node name="StateMachine" type="Node" parent="." node_paths=PackedStringArray("initial_state")]
script = ExtResource("5_machine")
initial_state = NodePath("PlayerRun")

;@ 2-4
[node name="PlayerRun" type="Node" parent="StateMachine" node_paths=PackedStringArray("player", "fall_state")]
;@ 5
[node name="PlayerRun" type="Node" parent="StateMachine" node_paths=PackedStringArray("player", "fall_state", "dash_state")]
;@ 6+
[node name="PlayerRun" type="Node" parent="StateMachine" node_paths=PackedStringArray("player", "fall_state", "dash_state", "attack_state")]
;@ all
script = ExtResource("6_run")
player = NodePath("../..")
fall_state = NodePath("../PlayerFall")
;@ 5+
dash_state = NodePath("../PlayerDash")
;@ 6+
attack_state = NodePath("../PlayerAttack")
;@ all

[node name="PlayerFall" type="Node" parent="StateMachine" node_paths=PackedStringArray("player", "run_state")]
script = ExtResource("7_fall")
player = NodePath("../..")
run_state = NodePath("../PlayerRun")
;@ 5+

[node name="PlayerDash" type="Node" parent="StateMachine" node_paths=PackedStringArray("player", "run_state")]
script = ExtResource("9_dash")
player = NodePath("../..")
run_state = NodePath("../PlayerRun")

[node name="DashDuration" type="Timer" parent="StateMachine/PlayerDash"]
one_shot = true
;@ 6+

[node name="PlayerAttack" type="Node" parent="StateMachine" node_paths=PackedStringArray("attack_component", "player", "run_state", "dash_state", "next_attack")]
script = ExtResource("15_attack")
attack = ExtResource("16_slash")
attack_component = NodePath("../../Mannequin/Rig_Medium/Skeleton3D/WeaponSlot/ShapeCast3D/AttackComponent")
player = NodePath("../..")
run_state = NodePath("../PlayerRun")
dash_state = NodePath("../PlayerDash")
next_attack = NodePath("../PlayerAttack2")

[node name="QueueTimer" type="Timer" parent="StateMachine/PlayerAttack"]
one_shot = true

[node name="PlayerAttack2" type="Node" parent="StateMachine" node_paths=PackedStringArray("attack_component", "player", "run_state", "dash_state", "next_attack")]
script = ExtResource("15_attack")
attack = ExtResource("17_stab")
attack_component = NodePath("../../Mannequin/Rig_Medium/Skeleton3D/WeaponSlot/ShapeCast3D/AttackComponent")
player = NodePath("../..")
run_state = NodePath("../PlayerRun")
dash_state = NodePath("../PlayerDash")
next_attack = NodePath("../PlayerAttack3")

[node name="QueueTimer" type="Timer" parent="StateMachine/PlayerAttack2"]
one_shot = true

[node name="PlayerAttack3" type="Node" parent="StateMachine" node_paths=PackedStringArray("attack_component", "player", "run_state", "dash_state")]
script = ExtResource("15_attack")
attack = ExtResource("18_spin")
attack_component = NodePath("../../Mannequin/Rig_Medium/Skeleton3D/WeaponSlot/ShapeCast3D/AttackComponent")
player = NodePath("../..")
run_state = NodePath("../PlayerRun")
dash_state = NodePath("../PlayerDash")

[node name="QueueTimer" type="Timer" parent="StateMachine/PlayerAttack3"]
one_shot = true

[node name="HealthComponent" type="Node" parent="."]
script = ExtResource("13_health")
max_health = 60.0

[node name="KnockbackComponent" type="Node" parent="."]
script = ExtResource("14_knockback")
;@ 5+

[node name="DashAudio" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("12_dash_audio")
bus = &"SFX"

[node name="DashRoot" type="Node3D" parent="."]

[node name="VerticalTrail" type="MeshInstance3D" parent="DashRoot"]
transform = Transform3D(-4.371139e-08, 0, 1, -8.742278e-08, -1, -3.821371e-15, 1, -8.742278e-08, 4.371139e-08, 0, 0, 1.5)
material_override = SubResource("ShaderMaterial_dash")
cast_shadow = 0
gi_mode = 0
mesh = SubResource("QuadMesh_vertical_trail")

[node name="GroundTrail" type="MeshInstance3D" parent="DashRoot"]
transform = Transform3D(-8.742278e-08, -1, -4.3711392e-08, 4.3711392e-08, 4.371139e-08, -1, 1, -8.742278e-08, 4.371139e-08, 0, 0, 2.5)
material_override = SubResource("ShaderMaterial_dash")
cast_shadow = 0
gi_mode = 0
mesh = SubResource("QuadMesh_ground_trail")

[node name="AnimationPlayer" type="AnimationPlayer" parent="DashRoot"]
libraries/ = SubResource("AnimationLibrary_dash")
autoplay = &"RESET"

;@ 5
[node name="View" type="Node" parent="." node_paths=PackedStringArray("player", "dash_root", "dash_animation", "dash_audio")]
;@ 6-8
[node name="View" type="Node" parent="." node_paths=PackedStringArray("player", "dash_root", "dash_animation", "dash_audio", "sword")]
;@ 9+
[node name="View" type="Node" parent="." node_paths=PackedStringArray("player", "dash_root", "dash_animation", "dash_audio", "sword", "damage_tint", "damage_audio")]
;@ 5+
script = ExtResource("10_view")
player = NodePath("..")
dash_root = NodePath("../DashRoot")
dash_animation = NodePath("../DashRoot/AnimationPlayer")
dash_audio = NodePath("../DashAudio")
;@ 6+
sword = NodePath("../Mannequin/Rig_Medium/Skeleton3D/WeaponSlot/ShapeCast3D/AttackComponent")
;@ 9+
damage_tint = NodePath("../DamageTint")
damage_audio = NodePath("../DamageAudio")
hit_rumble = ExtResource("20_hit_rumble")

[node name="DamageTint" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 0, 0, 0)

[node name="DamageAudio" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("19_damage_audio")
bus = &"SFX"
;@ all
