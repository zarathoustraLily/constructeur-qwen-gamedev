[gd_scene load_steps=27 format=3]
;@ all

[ext_resource type="Script" path="res://3_entities/hero/hero.gd" id="1_hero"]
[ext_resource type="Resource" path="res://5_data/hero/hero_settings.tres" id="2_settings"]
[ext_resource type="Script" path="res://3_entities/hero/hero_input.gd" id="3_input"]
;@ 4+
[ext_resource type="Script" path="res://1_core/components/stamina_component.gd" id="4_stamina"]
[ext_resource type="Resource" path="res://5_data/hero/hero_stamina.tres" id="5_stamina_settings"]
[ext_resource type="Script" path="res://1_core/input/input_buffer.gd" id="6_buffer"]
[ext_resource type="Script" path="res://1_core/state_machine/state_machine.gd" id="7_machine"]
[ext_resource type="Script" path="res://3_entities/hero/states/hero_move_state.gd" id="8_move"]
[ext_resource type="Script" path="res://3_entities/hero/states/hero_roll_state.gd" id="9_roll"]
;@ 5+
[ext_resource type="Script" path="res://3_entities/hero/hero_gun.gd" id="10_gun"]
[ext_resource type="Resource" path="res://5_data/hero/hero_gun.tres" id="11_gun_settings"]
[ext_resource type="Script" path="res://1_core/components/heat_component.gd" id="12_heat"]
[ext_resource type="Resource" path="res://5_data/hero/hero_gun_heat.tres" id="13_heat_settings"]
;@ 6+
[ext_resource type="Script" path="res://1_core/components/health_component.gd" id="14_health"]
[ext_resource type="Resource" path="res://5_data/hero/hero_health.tres" id="15_health_settings"]
[ext_resource type="Script" path="res://1_core/components/flask_component.gd" id="16_flasks"]
[ext_resource type="Script" path="res://3_entities/hero/states/hero_hit_state.gd" id="17_hit"]
[ext_resource type="Script" path="res://3_entities/hero/states/hero_heal_state.gd" id="18_heal"]
[ext_resource type="Script" path="res://3_entities/hero/states/hero_dead_state.gd" id="19_dead"]
