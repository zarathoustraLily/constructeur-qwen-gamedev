[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.35
height = 1.8
;@ 2-7

[sub_resource type="CapsuleMesh" id="CapsuleMesh_body"]
radius = 0.35
height = 1.8

[sub_resource type="BoxMesh" id="BoxMesh_nose"]
size = Vector3(0.2, 0.2, 0.3)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_nose"]
albedo_color = Color(0.9, 0.5, 0.1, 1)
;@ all

[node name="Hero" type="CharacterBody3D"]
script = ExtResource("1_hero")
settings = ExtResource("2_settings")

[node name="Shape" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")
;@ 2-7

[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
mesh = SubResource("CapsuleMesh_body")

[node name="Nose" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.4, -0.4)
mesh = SubResource("BoxMesh_nose")
surface_material_override/0 = SubResource("StandardMaterial3D_nose")
;@ all

[node name="Input" type="Node" parent="." node_paths=PackedStringArray("hero")]
script = ExtResource("3_input")
hero = NodePath("..")
;@ 4+

[node name="Stamina" type="Node" parent="."]
script = ExtResource("4_stamina")
settings = ExtResource("5_stamina_settings")

[node name="RollBuffer" type="Node" parent="."]
script = ExtResource("6_buffer")

[node name="StateMachine" type="Node" parent="." node_paths=PackedStringArray("initial_state")]
script = ExtResource("7_machine")
initial_state = NodePath("Move")

[node name="Move" type="Node" parent="StateMachine" node_paths=PackedStringArray("hero")]
script = ExtResource("8_move")
hero = NodePath("../..")

[node name="Roll" type="Node" parent="StateMachine" node_paths=PackedStringArray("hero")]
script = ExtResource("9_roll")
hero = NodePath("../..")
;@ 5+

[node name="Gun" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.3, 1.35, -0.45)
script = ExtResource("10_gun")
settings = ExtResource("11_gun_settings")

[node name="Heat" type="Node" parent="Gun"]
script = ExtResource("12_heat")
settings = ExtResource("13_heat_settings")
;@ all
;@ 6+

[node name="Health" type="Node" parent="."]
script = ExtResource("14_health")
settings = ExtResource("15_health_settings")

[node name="Flasks" type="Node" parent="."]
script = ExtResource("16_flasks")

[node name="HealBuffer" type="Node" parent="."]
script = ExtResource("6_buffer")

[node name="Hit" type="Node" parent="StateMachine" node_paths=PackedStringArray("hero")]
script = ExtResource("17_hit")
hero = NodePath("../..")

[node name="Heal" type="Node" parent="StateMachine" node_paths=PackedStringArray("hero")]
script = ExtResource("18_heal")
hero = NodePath("../..")

[node name="Dead" type="Node" parent="StateMachine" node_paths=PackedStringArray("hero")]
script = ExtResource("19_dead")
hero = NodePath("../..")
;@ all
;@ 8+

[node name="View" type="Node3D" parent="." node_paths=PackedStringArray("hero", "machine", "gun")]
script = ExtResource("20_view")
hero = NodePath("..")
machine = NodePath("../StateMachine")
gun = NodePath("../Gun")
settings = ExtResource("21_view_settings")
;@ 13+
hit_flash = ExtResource("23_flash")
;@ 8+

[node name="Model" parent="View" instance=ExtResource("22_model")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

[node name="AnimationTree" type="AnimationTree" parent="View"]
;@ all
;@ 16+

[node name="JumpBuffer" type="Node" parent="."]
script = ExtResource("6_buffer")

[node name="Jump" type="Node" parent="StateMachine" node_paths=PackedStringArray("hero")]
script = ExtResource("24_jump")
hero = NodePath("../..")
;@ 19+

[node name="MuzzleFlash" parent="Gun" instance=ExtResource("25_flash")]
;@ all
