[ext_resource type="Script" path="res://3_entities/hero/hero_view.gd" id="20_view"]
[ext_resource type="Resource" path="res://5_data/hero/hero_view.tres" id="21_view_settings"]
[ext_resource type="PackedScene" path="res://6_assets/Characters/Hero/hero_model.tscn" id="22_model"]
;@ 13+
[ext_resource type="Material" path="res://5_data/vfx/hit_flash_material.tres" id="23_flash"]
;@ 16+
[ext_resource type="Script" path="res://3_entities/hero/states/hero_jump_state.gd" id="24_jump"]
