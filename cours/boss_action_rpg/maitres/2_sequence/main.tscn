;@ 1
[gd_scene load_steps=6 format=3]
;@ 2+
[gd_scene load_steps=7 format=3]
;@ all

[ext_resource type="Script" path="res://2_sequence/main.gd" id="1_main"]
;@ 2+
[ext_resource type="PackedScene" path="res://3_entities/hero/hero.tscn" id="2_hero"]
;@ all

[sub_resource type="PlaneMesh" id="PlaneMesh_floor"]
size = Vector2(30, 22)

[sub_resource type="BoxShape3D" id="BoxShape3D_floor"]
size = Vector3(30, 1, 22)

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_sky"]

[sub_resource type="Sky" id="Sky_sky"]
sky_material = SubResource("ProceduralSkyMaterial_sky")

[sub_resource type="Environment" id="Environment_world"]
background_mode = 2
sky = SubResource("Sky_sky")

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="World" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_world")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, -0.354, 0.354, 0, 0.707, 0.707, -0.5, -0.612, 0.612, 0, 8, 0)
shadow_enabled = true

[node name="Floor" type="StaticBody3D" parent="."]

[node name="Mesh" type="MeshInstance3D" parent="Floor"]
mesh = SubResource("PlaneMesh_floor")

[node name="Shape" type="CollisionShape3D" parent="Floor"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
shape = SubResource("BoxShape3D_floor")

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.866, 0.5, 0, -0.5, 0.866, 0, 6, 12)
;@ 2+

[node name="Hero" parent="." node_paths=PackedStringArray("camera") instance=ExtResource("2_hero")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4)
camera = NodePath("../Camera")
