[node name="EditorShell" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shell")
;@ 6+
start_room = "res://5_data/salles/hangar.tres"
catalog = ExtResource("4_catalog")
settings = ExtResource("5_settings")
;@ all

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

;@ 1-8
[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
text = "Éditeur de niveaux"
;@ 9+
[node name="TopBar" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Layout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "Éditeur de niveaux"

;@ 10+
[node name="ModePicker" type="OptionButton" parent="Layout/TopBar"]
layout_mode = 2

;@ 9+
[node name="RoomPicker" type="OptionButton" parent="Layout/TopBar"]
layout_mode = 2

[node name="SaveButton" type="Button" parent="Layout/TopBar"]
layout_mode = 2
text = "Enregistrer"

[node name="DiscardButton" type="Button" parent="Layout/TopBar"]
layout_mode = 2
text = "Abandonner les modifications"
;@ all

[node name="Body" type="Control" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
;@ 6+

[node name="RoomView" type="Control" parent="Layout/Body"]
clip_contents = true
;@ 7+
focus_mode = 2
;@ 6+
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
;@ 8+
offset_left = 270.0
offset_right = -310.0
;@ 6+
script = ExtResource("2_view")

[node name="RoomViewInput" type="Node" parent="Layout/Body"]
script = ExtResource("3_view_input")
;@ 7+

[node name="SelectionOverlay" type="Control" parent="Layout/Body"]
