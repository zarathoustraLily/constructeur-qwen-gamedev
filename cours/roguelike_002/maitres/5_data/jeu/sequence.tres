[gd_resource type="Resource" script_class="SequenceDef" format=3]

[ext_resource type="Script" path="res://1_core/data/sequence_def.gd" id="1_sequence"]

[resource]
script = ExtResource("1_sequence")
id = &"sequence"
;@ 2+
first_screen = &"studio"
;@ 2-2
screens = Dictionary[StringName, String]({
&"studio": "res://2_sequence/jeu/studio_screen.tscn"
})
;@ 3-3
screens = Dictionary[StringName, String]({
&"avertissement": "res://2_sequence/jeu/disclaimer_screen.tscn",
&"studio": "res://2_sequence/jeu/studio_screen.tscn"
})
;@ 4-4
screens = Dictionary[StringName, String]({
&"avertissement": "res://2_sequence/jeu/disclaimer_screen.tscn",
&"menu": "res://2_sequence/jeu/menu_screen.tscn",
&"studio": "res://2_sequence/jeu/studio_screen.tscn"
})
;@ all
rng_seed = 2002
