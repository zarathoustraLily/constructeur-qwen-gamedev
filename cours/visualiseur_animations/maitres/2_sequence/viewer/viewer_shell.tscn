[gd_scene format=3]

[ext_resource type="Script" path="res://2_sequence/viewer/viewer_shell.gd" id="1_shell"]
[ext_resource type="Script" path="res://4_ui/viewer/asset_list.gd" id="2_list"]
;@ 2+
[ext_resource type="PackedScene" path="res://2_sequence/viewer/viewer_stage.tscn" id="3_stage"]
[ext_resource type="Script" path="res://4_ui/viewer/clip_list.gd" id="4_clips"]
;@ 3+
[ext_resource type="Script" path="res://4_ui/viewer/orbit_input.gd" id="5_orbit"]
;@ all

[node name="ViewerShell" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shell")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Body" type="HSplitContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="AssetList" type="Tree" parent="Layout/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
hide_root = true
script = ExtResource("2_list")
;@ 1

[node name="Hint" type="Label" parent="Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3
text = "Les assets trouvés sont dans la liste."
horizontal_alignment = 1
vertical_alignment = 1
;@ 2+

[node name="Right" type="HBoxContainer" parent="Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Main" type="VBoxContainer" parent="Layout/Body/Right"]
layout_mode = 2
size_flags_horizontal = 3

[node name="StageContainer" type="SubViewportContainer" parent="Layout/Body/Right/Main"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
stretch = true

[node name="StageViewport" type="SubViewport" parent="Layout/Body/Right/Main/StageContainer"]
handle_input_locally = false
size = Vector2i(1024, 720)
render_target_update_mode = 4

[node name="ViewerStage" parent="Layout/Body/Right/Main/StageContainer/StageViewport" instance=ExtResource("3_stage")]
unique_name_in_owner = true
;@ 3+

[node name="Controls" type="HBoxContainer" parent="Layout/Body/Right/Main"]
layout_mode = 2

[node name="GameViewButton" type="Button" parent="Layout/Body/Right/Main/Controls"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_pressed = true
text = "Vue du jeu (Y)"
;@ 2+

[node name="ClipList" type="ItemList" parent="Layout/Body/Right"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
script = ExtResource("4_clips")
;@ all

[node name="Status" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Recherche des assets…"
;@ 3+

[node name="OrbitInput" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("5_orbit")
;@ all
